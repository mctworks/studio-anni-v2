{
    "name": "mctworks/studio-anni-v2",
    "description": "Studio Anni V2: Slim 4 JSON API and React front end",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "php-di/php-di": "^7.0",
        "slim/psr7": "^1.0",
        "slim/slim": "^4.0",
        "vlucas/phpdotenv": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "migrate": "php bin/migrate.php"
    }
}
